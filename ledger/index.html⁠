<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hello Busan - 記帳本</title>
    <link href="https://fonts.googleapis.com/css2?family=Huninn&family=Noto+Serif+TC:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #F8F6F2;
            --card-bg: #FFFFFF;
            --accent-purple: #DCD6F7; /* 色票1：霧紫 (總金額與選中日期底色) */
            --accent-green: #D4E2D4;  /* 色票2：柔綠 (確認按鈕) */
            --accent-pink: #F3C68F;   /* 色票3：奶橘 */
            --accent-blue: #C5E3F6;   /* 色票4：粉藍 */
            --accent-yellow: #FAEBE0; /* 色票5：米黃 */
            --accent-orange: #E8C4C4; /* 色票6：柔粉紅 */
            
            --text-dark: rgba(43, 38, 37, 0.85); /* 85% 灰色深色字 */
            --text-muted: #9E958C;
            --border-light: #EFECE6;
            --border-radius: 18px;
            --border-radius-sm: 10px;
        }

        * {
            box-sizing: border-box;
            font-family: 'Huninn', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-dark);
            padding: 16px;
            max-width: 480px;
            margin: 0 auto;
        }

        /* 頂部 Header 區塊 */
        .app-header {
            text-align: center;
            padding: 12px 0 16px 0;
            position: relative;
        }

        .sub-header {
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .main-title-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .main-title {
            font-family: 'Noto Serif TC', serif;
            font-size: 22px;
            font-weight: 600;
            color: var(--text-dark);
        }

        /* 日期頁籤列 */
        .date-tabs {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 8px 16px 8px;
            margin-bottom: 12px;
            border-bottom: 1px solid var(--border-light);
        }

        .date-tab {
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            padding: 6px 4px;
            border-radius: 8px;
        }

        .date-tab .weekday {
            font-size: 10px;
            letter-spacing: 1px;
            margin-bottom: 2px;
            text-transform: uppercase;
            color: var(--text-dark);
        }

        .date-tab .day {
            font-family: 'Noto Serif TC', serif;
            font-size: 18px;
            color: var(--text-dark);
        }

        .date-tab.active {
            background-color: var(--accent-purple);
            font-weight: bold;
        }

        .date-tab.active .weekday,
        .date-tab.active .day {
            color: #2B2333;
        }

        /* 總金額簡約欄位 */
        .summary-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--accent-purple);
            padding: 14px 18px;
            border-radius: var(--border-radius-sm);
            margin-bottom: 16px;
        }

        .summary-label {
            font-size: 13px;
            color: #554A60;
        }

        .summary-value {
            font-weight: bold;
            font-size: 16px;
            color: #2B2333;
        }

        /* 新增消費紀錄卡片 */
        .form-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 22px 18px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.02);
            margin-bottom: 20px;
            border: 1px solid #F0ECE6;
        }

        .form-header {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 18px;
        }

        .input-row-item {
            margin-bottom: 18px;
        }

        .input-item-name {
            width: 100%;
            border: none;
            border-bottom: 1px solid var(--border-light);
            padding: 8px 0;
            font-size: 16px;
            color: var(--text-dark);
            outline: none;
            background: transparent;
        }

        .input-item-name::placeholder {
            color: var(--text-muted);
        }

        .input-amount-wrap {
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 4px;
        }

        .input-amount {
            flex: 1;
            border: none;
            font-size: 22px;
            font-weight: bold;
            color: var(--text-dark);
            outline: none;
            background: transparent;
        }

        .currency-badge {
            font-size: 12px;
            color: var(--text-muted);
            background-color: #F5F2EC;
            padding: 4px 10px;
            border-radius: 4px;
            border: 1px solid #E8E3DA;
        }

        .rate-calc-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
            margin-bottom: 20px;
        }

        .rate-calc {
            font-size: 11px;
            color: var(--text-muted);
        }

        .refresh-rate-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 1px solid #E5E0D8;
            background-color: transparent;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .refresh-rate-btn svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .refresh-rate-btn:active {
            transform: rotate(180deg);
        }

        .payer-section-title {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        /* 圓圈付款人按鈕 */
        .payer-circle-group {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .payer-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid var(--text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--text-dark);
            background-color: #FFFFFF;
            cursor: pointer;
            transition: all 0.2s;
        }

        .payer-circle.active[data-payer="All"] { background-color: var(--accent-yellow); font-weight: bold; }
        .payer-circle.active[data-payer="Jase"] { background-color: var(--accent-green); font-weight: bold; }
        .payer-circle.active[data-payer="Jessie"] { background-color: var(--accent-pink); font-weight: bold; }
        .payer-circle.active[data-payer="Jewel"] { background-color: var(--accent-blue); font-weight: bold; }
        .payer-circle.active[data-payer="Kay"] { background-color: var(--accent-orange); font-weight: bold; }

        /* 確認按鈕 */
        .btn-save-cloud {
            width: 100%;
            padding: 14px;
            background-color: var(--accent-green);
            color: #3F523F;
            border: none;
            border-radius: var(--border-radius-sm);
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 1px;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-save-cloud:active {
            opacity: 0.8;
        }

        /* 篩選與列表 */
        .filter-tabs {
            display: flex;
            gap: 16px;
            overflow-x: auto;
            padding-bottom: 8px;
            margin-bottom: 14px;
            border-bottom: 1px solid var(--border-light);
        }

        .filter-item {
            font-size: 13px;
            color: var(--text-muted);
            padding-bottom: 6px;
            cursor: pointer;
            white-space: nowrap;
            position: relative;
        }

        .filter-item.active {
            color: var(--text-dark);
            font-weight: bold;
        }

        .filter-item.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--text-dark);
        }

        .record-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius-sm);
            padding: 16px;
            margin-bottom: 10px;
            border: 1px solid #F0ECE6;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .record-title {
            font-size: 15px;
            font-weight: 500;
            margin-bottom: 4px;
            color: var(--text-dark);
        }

        .record-payers {
            font-size: 12px;
            color: var(--text-muted);
        }

        .record-amount {
            font-size: 16px;
            font-weight: bold;
            text-align: right;
            color: var(--text-dark);
        }

        .record-sub-amount {
            font-size: 11px;
            color: var(--text-muted);
            text-align: right;
        }

        .action-btns {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 6px;
        }

        .action-btn {
            background: none;
            border: none;
            font-size: 11px;
            color: var(--text-muted);
            cursor: pointer;
        }

        .action-btn.delete {
            color: #D9534F;
        }

        /* 彈出式編輯視窗 (Modal) 樣式 */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 16px;
        }

        .modal-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 22px 18px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            border: 1px solid #F0ECE6;
        }

        .modal-btns {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-modal-cancel {
            flex: 1;
            padding: 12px;
            background-color: #EFECE6;
            color: var(--text-dark);
            border: none;
            border-radius: var(--border-radius-sm);
            font-size: 14px;
            cursor: pointer;
        }

        .btn-modal-save {
            flex: 1;
            padding: 12px;
            background-color: var(--accent-purple);
            color: #2B2333;
            border: none;
            border-radius: var(--border-radius-sm);
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- 頂部 Header -->
    <div class="app-header" style="position: relative;">
        <!-- 返回首頁按鈕 -->
        <a href="../index.html" style="position: absolute; left: 0; top: 12px; width: 28px; height: 28px; border-radius: 50%; border: 1px solid #E5E0D8; display: flex; align-items: center; justify-content: center; text-decoration: none; color: #9E958C; font-size: 14px; background: #FFF;">←</a>
        
        <div class="sub-header">Hi 2027</div>
        <div class="main-title-wrap">
            <span class="main-title">Hello Busan</span>
        </div>
    </div>


    <!-- 極簡日期頁籤列 -->
    <div class="date-tabs" id="dateTabs">
        <div class="date-tab active" onclick="selectDate('12/29')">
            <div class="weekday">TUE</div>
            <div class="day">29</div>
        </div>
        <div class="date-tab" onclick="selectDate('12/30')">
            <div class="weekday">WED</div>
            <div class="day">30</div>
        </div>
        <div class="date-tab" onclick="selectDate('12/31')">
            <div class="weekday">THU</div>
            <div class="day">31</div>
        </div>
        <div class="date-tab" onclick="selectDate('1/1')">
            <div class="weekday">FRI</div>
            <div class="day">1</div>
        </div>
        <div class="date-tab" onclick="selectDate('1/2')">
            <div class="weekday">SAT</div>
            <div class="day">2</div>
        </div>
        <div class="date-tab" onclick="selectDate('1/3')">
            <div class="weekday">SUN</div>
            <div class="day">3</div>
        </div>
    </div>

    <!-- 總額簡約提示 -->
    <div class="summary-bar">
        <div class="summary-label" id="summaryTitle">消費總金額</div>
        <div class="summary-value" id="summaryTotal">₩ 0 (≈ NT$ 0)</div>
    </div>

    <!-- 新增消費卡片 -->
    <div class="form-card">
        <div class="form-header">
            <span>✎</span>
            <span>新增款項</span>
        </div>

        <div class="input-row-item">
            <input type="text" id="itemName" class="input-item-name" placeholder="晚餐">
        </div>

        <div class="input-amount-wrap">
            <input type="number" id="itemAmount" class="input-amount" value="888" oninput="updateRatePreview()">
            <span class="currency-badge">KRW</span>
        </div>

        <div class="rate-calc-bar">
            <div class="rate-calc" id="rateCalcText">匯率載入中...</div>
            <div class="refresh-rate-btn" onclick="fetchExchangeRate()" title="更新匯率">
                <svg viewBox="0 0 24 24">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.73-5.73"></path>
                </svg>
            </div>
        </div>

        <div class="payer-section-title">付款人</div>

        <div class="payer-circle-group" id="payerCircles">
            <!-- 動態產生付款人按鈕 -->
        </div>

        <button class="btn-save-cloud" onclick="addRecord()">確認</button>
    </div>

    <!-- 明細個人篩選區 -->
    <div class="filter-tabs" id="filterTabs">
        <div class="filter-item active" onclick="filterByPerson('All')">全部明細</div>
        <div class="filter-item" onclick="filterByPerson('Jase')">Jase</div>
        <div class="filter-item" onclick="filterByPerson('Jessie')">Jessie</div>
        <div class="filter-item" onclick="filterByPerson('Jewel')">Jewel</div>
        <div class="filter-item" onclick="filterByPerson('Kay')">Kay</div>
    </div>

    <!-- 消費明細表 -->
    <div id="recordList">
        <!-- 動態渲染卡片 -->
    </div>

    <!-- 彈出式編輯視窗 (Modal) -->
    <div class="modal-overlay" id="editModal">
        <div class="modal-card">
            <div class="form-header">
                <span>✎</span>
                <span>編輯款項</span>
            </div>
            <div class="input-row-item">
                <input type="text" id="editItemName" class="input-item-name" placeholder="項目名稱">
            </div>
            <div class="input-amount-wrap">
                <input type="number" id="editItemAmount" class="input-amount" placeholder="金額">
                <span class="currency-badge">KRW</span>
            </div>
            <div class="payer-section-title" style="margin-top: 16px;">付款人</div>
            <div class="payer-circle-group" id="editPayerCircles">
                <!-- 編輯視窗的付款人選單 -->
            </div>
            <div class="modal-btns">
                <button class="btn-modal-cancel" onclick="closeEditModal()">取消</button>
                <button class="btn-modal-save" onclick="saveEditedRecord()">儲存修改</button>
            </div>
        </div>
    </div>

    <script>
        let krwPerTwd = 41.5; 
        const MEMBERS = ['Jase', 'Jessie', 'Jewel', 'Kay'];
        
        let currentDate = '12/29';
        let currentFilter = 'All';
        let selectedPayers = ['All'];
        
        // 編輯視窗專用狀態
        let editingId = null;
        let editSelectedPayers = ['All'];

        let records = [
            { id: 1, date: '12/29', name: '海雲台高級住宿 x1晚', krw: 999999, payers: ['Jase', 'Jessie', 'Jewel', 'Kay'] },
            { id: 2, date: '12/29', name: '晚餐', krw: 888, payers: ['Jase', 'Jessie', 'Jewel', 'Kay'] }
        ];

        async function fetchExchangeRate() {
            try {
                const response = await fetch('https://open.er-api.com/v6/latest/TWD');
                const data = await response.json();
                if (data && data.rates && data.rates.KRW) {
                    krwPerTwd = data.rates.KRW;
                }
            } catch (error) {
                console.log('無法連線即時匯率，使用預設值', error);
            }
            updateRatePreview();
            renderList();
        }

        function updateRatePreview() {
            const krw = parseFloat(document.getElementById('itemAmount').value) || 0;
            const twd = Math.round(krw / krwPerTwd);
            const rateOneKrw = (1 / krwPerTwd).toFixed(4);
            document.getElementById('rateCalcText').innerText = `即時匯率：1 KRW ≈ ${rateOneKrw} TWD (試算 NT$ ${twd.toLocaleString()})`;
        }

        function togglePayer(payer) {
            if (payer === 'All') {
                selectedPayers = ['All'];
            } else {
                selectedPayers = selectedPayers.filter(p => p !== 'All');
                if (selectedPayers.includes(payer)) {
                    selectedPayers = selectedPayers.filter(p => p !== payer);
                } else {
                    selectedPayers.push(payer);
                }
                if (selectedPayers.length === 0) selectedPayers = ['All'];
            }
            renderPayerCircles();
        }

        function toggleEditPayer(payer) {
            if (payer === 'All') {
                editSelectedPayers = ['All'];
            } else {
                editSelectedPayers = editSelectedPayers.filter(p => p !== 'All');
                if (editSelectedPayers.includes(payer)) {
                    editSelectedPayers = editSelectedPayers.filter(p => p !== payer);
                } else {
                    editSelectedPayers.push(payer);
                }
                if (editSelectedPayers.length === 0) editSelectedPayers = ['All'];
            }
            renderEditPayerCircles();
        }

        function renderPayerCircles() {
            const container = document.getElementById('payerCircles');
            const list = [
                { id: 'All', label: 'All' },
                { id: 'Jase', label: 'J' },
                { id: 'Jessie', label: 'J' },
                { id: 'Jewel', label: 'J' },
                { id: 'Kay', label: 'K' }
            ];
            container.innerHTML = list.map(item => `
                <div class="payer-circle ${selectedPayers.includes(item.id) ? 'active' : ''}" data-payer="${item.id}" onclick="togglePayer('${item.id}')">
                    ${item.label}
                </div>
            `).join('');
        }

        function renderEditPayerCircles() {
            const container = document.getElementById('editPayerCircles');
            const list = [
                { id: 'All', label: 'All' },
                { id: 'Jase', label: 'J' },
                { id: 'Jessie', label: 'J' },
                { id: 'Jewel', label: 'J' },
                { id: 'Kay', label: 'K' }
            ];
            container.innerHTML = list.map(item => `
                <div class="payer-circle ${editSelectedPayers.includes(item.id) ? 'active' : ''}" data-payer="${item.id}" onclick="toggleEditPayer('${item.id}')">
                    ${item.label}
                </div>
            `).join('');
        }

        function selectDate(date) {
            currentDate = date;
            document.querySelectorAll('.date-tab').forEach(tab => {
                const onClickAttr = tab.getAttribute('onclick');
                tab.classList.toggle('active', onClickAttr && onClickAttr.includes(date));
            });
            renderList();
        }

        function filterByPerson(person) {
            currentFilter = person;
            document.querySelectorAll('.filter-item').forEach(item => {
                const text = item.innerText.trim();
                item.classList.toggle('active', text === person || (person === 'All' && text === '全部明細'));
            });
            renderList();
        }

        function addRecord() {
            const nameInput = document.getElementById('itemName');
            const amountInput = document.getElementById('itemAmount');
            
            const name = nameInput.value.trim();
            const krw = parseFloat(amountInput.value);

            if (!name || isNaN(krw)) return;

            const payers = selectedPayers.includes('All') ? [...MEMBERS] : [...selectedPayers];

            records.push({
                id: Date.now(),
                date: currentDate,
                name,
                krw,
                payers
            });

            nameInput.value = '';
            amountInput.value = '888';
            selectedPayers = ['All'];
            renderPayerCircles();
            updateRatePreview();
            renderList();
        }

        // 開啟彈出式編輯視窗
        function openEditModal(id) {
            const item = records.find(r => r.id === id);
            if (!item) return;

            editingId = id;
            document.getElementById('editItemName').value = item.name;
            document.getElementById('editItemAmount').value = item.krw;
            editSelectedPayers = item.payers.length === MEMBERS.length ? ['All'] : [...item.payers];
            
            renderEditPayerCircles();
            document.getElementById('editModal').style.display = 'flex';
        }

        // 關閉彈出式編輯視窗
        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
            editingId = null;
        }

        // 儲存編輯後的新資料
        function saveEditedRecord() {
            const name = document.getElementById('editItemName').value.trim();
            const krw = parseFloat(document.getElementById('editItemAmount').value);

            if (!name || isNaN(krw) || !editingId) return;

            const payers = editSelectedPayers.includes('All') ? [...MEMBERS] : [...editSelectedPayers];

            records = records.map(r => r.id === editingId ? { ...r, name, krw, payers } : r);
            
            closeEditModal();
            renderList();
        }

        function deleteRecord(id) {
            records = records.filter(r => r.id !== id);
            renderList();
        }

        function renderList() {
            const container = document.getElementById('recordList');
            
            let filtered = records.filter(r => r.date === currentDate);
            if (currentFilter !== 'All') {
                filtered = filtered.filter(r => r.payers.includes(currentFilter));
            }

            let totalKRW = 0;
            records.forEach(r => {
                if (currentFilter === 'All') {
                    totalKRW += r.krw;
                } else if (r.payers.includes(currentFilter)) {
                    totalKRW += (r.krw / r.payers.length);
                }
            });

            const totalTWD = Math.round(totalKRW / krwPerTwd);
            document.getElementById('summaryTotal').innerText = `₩ ${Math.round(totalKRW).toLocaleString()} (≈ NT$ ${totalTWD.toLocaleString()})`;

            container.innerHTML = filtered.map(item => {
                const twd = Math.round(item.krw / krwPerTwd);
                const payerText = item.payers.length === MEMBERS.length ? 'All (Jase, Jessie, Jewel, Kay)' : item.payers.join(', ');
                
                return `
                    <div class="record-card">
                        <div>
                            <div class="record-title">${item.name}</div>
                            <div class="record-payers">${payerText}</div>
                        </div>
                        <div>
                            <div class="record-amount">₩ ${item.krw.toLocaleString()}</div>
                            <div class="record-sub-amount">≈ NT$ ${twd.toLocaleString()}</div>
                            <div class="action-btns">
                                <button class="action-btn" onclick="openEditModal(${item.id})">編輯</button>
                                <button class="action-btn delete" onclick="deleteRecord(${item.id})">刪除</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        renderPayerCircles();
        fetchExchangeRate();
    </script>

